rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 👤 User Profiles & Contacts
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 🗺️ Journeys
    match /journeys/{journeyId} {
      allow create: if request.auth != null;
      // Allow read if the user is the owner, a selected guardian, 
      // OR if the journey is currently active (allows anonymous tracking via SMS link)
      allow read: if (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.selectedGuardianId == request.auth.uid))
                  || (resource.data.isActive == true);
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 📍 Live Locations
    match /live_locations/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 🔔 Notifications (In-App)
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.recipientId == request.auth.uid;
    }

    // 🚨 SOS Alerts
    match /alerts/{alertId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null; 
    }
  }
}
